{
  "name": "@xavadao/xinf-plugin",
  "version": "0.1.1",
  "description": "Xava Inference for AI coding agents: every text, image, video and audio model on one account. Sign in from your agent and spend your balance within a daily cap.",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/xavadao/xinf-plugin",
  "xinf": {
    "repo": "xavadao/xinf-plugin",
    "baseUrl": "https://xavainf.com"
  },
  "keywords": [
    "pi-package",
    "xinf",
    "mcp",
    "x402",
    "codex-plugin",
    "claude-plugin",
    "skills",
    "inference"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "retarget": "node scripts/retarget.mjs"
  },
  "pi": {
    "extensions": [
      "./.pi/extensions/xinf.ts"
    ],
    "skills": [
      "./plugins/xinf/skills"
    ]
  },
  "dependencies": {
    "pi-mcp-adapter": "2.11.0"
  },
  "bundledDependencies": [
    "pi-mcp-adapter"
  ],
  "bin": {
    "xinf-login": "bin/xinf-login.mjs"
  },
  "exports": {
    "./deepseek": "./clients/deepseek/index.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./clients/deepseek/cordis.patch.yml" }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "^0.2.0-0 || ^0.2.1-0",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.0-0 || ^0.2.1-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": { "optional": true },
    "@deepseek-ai/dsh-skill-filesystem": { "optional": true }
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
